# Copy this file to ".env" and set your OpenAI API key.
#
# OPENAI_API_KEY is read ONLY by the Electron main process (main.js) and passed to the
# renderer through a secure IPC channel. Vite does not expose variables without the
# VITE_ prefix, so this key is never inlined into the client-side bundle.
OPENAI_API_KEY=your_openai_api_key

# Optional: only when you open the app in a plain web browser (./run.sh browser).
# Do NOT put a real VITE_ key here for production builds: Vite inlines VITE_* variables
# into the bundle. Put it in ".env.development.local" instead (it is loaded only by the
# dev server, never by "vite build").
# VITE_OPENAI_API_KEY=your_openai_api_key
