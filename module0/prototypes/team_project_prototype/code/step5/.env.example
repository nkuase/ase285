# Database Configuration: "sqlite" (default) or "mongodb"
DB_TYPE=sqlite

# MongoDB Configuration (used when DB_TYPE=mongodb)
MONGO_USER=your_username
MONGO_PASSWORD=your_password
# The cluster id (xxxxx) or the full host (cluster0.xxxxx.mongodb.net)
MONGO_CLUSTER=xxxxx
MONGO_DATABASE=todoapp
# Or use a full connection string instead (it overrides the four values above):
# MONGO_URI=mongodb://localhost:27017

# SQLite Configuration (used when DB_TYPE=sqlite)
SQLITE_PATH=./todoapp.sqlite
