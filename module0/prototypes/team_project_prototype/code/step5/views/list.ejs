<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Required meta tags -->
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

  <!-- Bootstrap CSS -->
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css"
    integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous" />

  <title>Todo App - List</title>
</head>

<body>
  <%- include('nav.ejs') %>

    <h4 class="container mt-4"><strong>List Page</strong></h4>

    <ul class="list-group container">
      <% for (var i=0; i < posts.length; i++){ %>
        <li class="list-group-item">
          <h4>
            <a href="/detail/<%= posts[i]._id %>">Title : <%= posts[i].title %></a>
          </h4>
          <p> Date : <%= posts[i].date %>
          </p>
          <p> Id : <%= posts[i]._id %>
          </p>
          <button class="delete btn btn-danger" data-id="<%= posts[i]._id %>">Delete</button>
        </li>
        <% } %>
    </ul>

    <!-- jQuery: used for the AJAX call that deletes a post -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script>
      $('.delete').click(function (e) {
        const button = $(this);
        $.ajax({
          method: 'DELETE',
          url: '/delete',
          // dataset.id is from: data-id="<%= posts[i]._id %>"
          data: { _id: e.target.dataset.id }
        }).done(() => {
          button.closest('li').fadeOut();
        }).fail((xhr, code, err) => {
          console.error('Failed to delete:', err);
          alert('Failed to delete the post');
        });
      });
    </script>
</body>

</html>
