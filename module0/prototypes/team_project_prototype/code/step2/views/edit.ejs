<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Required meta tags -->
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

  <!-- Bootstrap CSS -->
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css"
    integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous" />

  <title>Todo App - Edit</title>
</head>

<body>
  <%- include('nav.ejs') %>

    <h4 class="container mt-4"><strong>Edit Page</strong></h4>

    <div class="container mt-3">
      <!-- An HTML form can only send GET or POST: method-override turns "?_method=PUT" into PUT /edit -->
      <form action="/edit?_method=PUT" method="POST">
        <input type="hidden" name="id" value="<%= data._id %>" />
        <div class="form-group">
          <label>Update: What to do today</label>
          <!-- The value must be in quotes, or a title with spaces would be cut at the first space -->
          <input type="text" class="form-control" name="title" value="<%= data.title %>" required />
        </div>
        <div class="form-group">
          <label>Update: Date</label>
          <input type="text" class="form-control" name="date" value="<%= data.date %>" required />
        </div>
        <button type="submit" class="btn btn-outline-secondary">Submit</button>
        <a href="/list" class="btn btn-outline-primary">Cancel</a>
      </form>
    </div>
</body>

</html>
