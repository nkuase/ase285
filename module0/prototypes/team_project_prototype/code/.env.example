# Shared by step1, step2, and step3 (they load "code/.env").
# Copy this file to ".env" in this directory and fill in your values.
# (step4 needs no configuration, and step5 has its own .env.)

MONGO_USER=your_username
MONGO_PASSWORD=your_password

# MongoDB Atlas cluster. Either of these two forms works:
#   - the cluster id, e.g. xxxxx   (the part between "cluster0." and ".mongodb.net")
#   - the full host,  e.g. cluster0.xxxxx.mongodb.net
MONGO_CLUSTER=xxxxx

MONGO_DATABASE=todoapp

# Or use a full connection string (it overrides the values above), e.g. a local MongoDB:
# MONGO_URI=mongodb://localhost:27017
